{
  "app-id": "ru.mono.launcher",
  "branch": "stable",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "mono-launcher",
  "finish-args": [
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host",
    "--talk-name=org.freedesktop.FileManager1"
  ],
  "modules": [
    {
      "name": "node",
      "buildsystem": "simple",
      "build-commands": ["npm ci"]
    },
    {
      "name": "mono-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "npm run build",
        "cd src-tauri && cargo build --release",
        "install -Dm755 target/release/mono-launcher /app/bin/mono-launcher"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/n1orio/mono-launcher/archive/refs/heads/main.tar.gz",
          "dest-filename": "mono-launcher.tar.gz"
        }
      ]
    }
  ]
}
