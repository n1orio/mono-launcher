# Mono Launcher — Desktop Minecraft modpack launcher
# Пакет для Arch/CachyOS: переупаковывает официальный .deb из GitHub Releases.
#
# Для сабмита в официальный репозиторий CachyOS:
#   1) скопируйте этот файл в форк https://git.cachyos.org/CachyOS/cachyos-pkgbuilds
#      (или GitHub CachyOS/cachyos-pkgbuilds) в папку вида `packages/desktop/mono-launcher/`
#   2) обновите pkgver и sha256sums под новый релиз
#   3) откройте Merge Request в ветку packages
#   4) при желании позже замените на сборку из исходников (node+rust+webkit).

# Maintainer: NIO <you@example.com>   # замените на свои контакты
pkgname=mono-launcher
pkgver=1.3.1
pkgrel=1
pkgdesc="Desktop Minecraft modpack launcher (mrpack)"
arch=('x86_64')
url="https://github.com/n1orio/mono-launcher"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg')
source=("https://github.com/n1orio/mono-launcher/releases/download/launcher-v${pkgver}/Mono.Launcher_${pkgver}_amd64.deb")
# После первого успешного релиза замените SKIP на реальный hash: sha256sum <file.deb>
sha256sums=('SKIP')

package() {
  # Распаковываем .deb: внутри лежат control.tar.gz и data.tar.gz
  bsdtar -xf "${srcdir}/Mono.Launcher_${pkgver}_amd64.deb" -C "${srcdir}"
  # data.tar.gz содержит ./usr/... (бинарник, иконки, .desktop) — раскладываем в pkgdir
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
}
